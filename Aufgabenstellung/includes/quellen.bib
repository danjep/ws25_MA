@article{Kou+24,
 abstract = {In the weak memory consistency literature, the semantics of concurrent programs is typically defined as a constraint on execution graphs, expressed in relational algebra. Prior work has shown that basic metatheoretic questions about memory models are decidable as long as they can be expressed as irreflexivity and emptiness constraints over Kleene Algebra with Tests (KAT), a condition that rules out practical memory models such the C/C++ and the Linux kernel models.

In this paper, we extend these results to memory models containing arbitrary intersections with uninterpreted relations. We can thus automatically establish compilation correctness and derive efficient incremental consistency checkers for RC11, LKMM, and other memory models.

LIPIcs, Vol. 311, 35th International Conference on Concurrency Theory (CONCUR 2024), pages 33:1-33:16},
 author = {Koutsouridis, Aristotelis and Kokologiannakis, Michalis and Vafeiadis, Viktor},
 year = {2024},
 title = {Automating Memory Model Metatheory with Intersections: Schloss Dagstuhl -- Leibniz-Zentrum f{\"u}r Informatik},
 keywords = {Main},
 volume = {311},
 journal = {LIPIcs, Volume 311, CONCUR 2024},
 doi = {10.4230/LIPICS.CONCUR.2024.33},
 file = {Koutsouridis, Kokologiannakis et al. 2024 - Automating Memory Model Metatheory:Attachments/Koutsouridis, Kokologiannakis et al. 2024 - Automating Memory Model Metatheory.pdf:application/pdf}
}


